// Prisma Schema untuk Aplikasi Bisnis Suntik Sosial Media ID
// Provider: SQLite (Dapat diubah ke postgresql/mysql di produksi)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// TABEL 1: Paket Suntik Sosmed (Etalase Produk)
model Paket {
  id            Int      @id @default(autoincrement()) // ID Unik Primary Key
  kode_paket    Int      @unique                       // Kode angka unik wajib (contoh: 101, 201)
  platform      String                                 // Platform: Instagram / TikTok / YouTube / dll
  nama_paket    String                                 // Nama Paket (contoh: Followers 1K)
  harga         Int                                    // Harga dalam Rupiah (tanpa titik, contoh: 15000)
  estimasi      String                                 // Estimasi waktu pengerjaan (contoh: 1-15 menit)
  garansi       String                                 // Info garansi (contoh: 30 hari)
  butuh_password Boolean @default(false)               // Penanda apakah butuh password akun
  status_aktif  Boolean  @default(true)                // Penanda paket aktif/tampil di etalase
  urutan        Int      @default(0)                   // Urutan penampilan di website
  dibuatPada    DateTime @default(now())               // Waktu data dibuat
  diupdatePada  DateTime @updatedAt                    // Waktu data diupdate otomatis

  // Relasi ke Tabel Order (1 Paket bisa memiliki banyak Order)
  orders Order[]

  @@index([kode_paket])
  @@map("paket")
}

// TABEL 2: Pelanggan (Data Pengguna yang Pernah Order)
model Pelanggan {
  id          Int      @id @default(autoincrement()) // ID Unik Primary Key
  nomor_wa    String   @unique                       // Nomor WhatsApp unik (format 628xxx)
  nama        String?                                // Nama Pelanggan (opsional/diambil dari nama WA)
  total_order Int      @default(0)                   // Jumlah akumulasi order yang dibuat
  dibuatPada  DateTime @default(now())               // Waktu pendaftaran pertama
  diupdatePada DateTime @updatedAt                   // Waktu terakhir diupdate

  // Relasi ke Tabel Order (1 Pelanggan bisa membuat banyak Order)
  orders Order[]

  @@index([nomor_wa])
  @@map("pelanggan")
}

// TABEL 3: Order (Data Pesanan Pelanggan)
// Status Order valid: 'BARU' | 'MENUNGGU_BAYAR' | 'SUDAH_BAYAR' | 'DIPROSES' | 'SELESAI' | 'GAGAL' | 'REFUND'
model Order {
  id                 Int      @id @default(autoincrement()) // ID Unik Primary Key
  no_invoice         String   @unique                       // Nomor Invoice Unik (contoh: INV0810001)
  kode_paket         Int                                    // Kode paket angka (referensi kode_paket)
  paket_id           Int                                    // Foreign Key ke tabel paket
  pelanggan_id       Int                                    // Foreign Key ke tabel pelanggan
  nomor_wa_pelanggan String                                 // Nomor WA pemesan saat transaksi
  link_akun          String                                 // Target Link Akun Instagram/TikTok/YouTube
  jumlah             Int      @default(1)                   // Jumlah paket yang dipesan
  total_harga        Int                                    // Total harga nominal rupiah
  status_order       String   @default("MENUNGGU_BAYAR")    // Status pesanan: BARU, MENUNGGU_BAYAR, SUDAH_BAYAR, DIPROSES, SELESAI, GAGAL, REFUND
  bukti_bayar_url    String?                                // URL/Path foto bukti pembayaran jika ada
  catatan_admin      String?                                // Catatan internal dari admin
  id_order_provider  String?                                // ID Ref dari Provider SMM Panel luar (opsional)
  dibuatPada         DateTime @default(now())               // Tanggal pesanan dibuat
  diupdatePada       DateTime @updatedAt                    // Waktu pembaruan status pesanan

  // Definisi Relasi
  paket     Paket     @relation(fields: [paket_id], references: [id], onDelete: Cascade)
  pelanggan Pelanggan @relation(fields: [pelanggan_id], references: [id], onDelete: Cascade)

  @@index([no_invoice])
  @@index([kode_paket])
  @@index([nomor_wa_pelanggan])
  @@index([status_order])
  @@map("order")
}

// TABEL 4: Log Pesan WA (Catatan Pesan Masuk & Keluar Gateway)
// Tipe pesan valid: 'MASUK' | 'KELUAR'
model LogPesanWa {
  id             Int      @id @default(autoincrement()) // ID Unik Primary Key
  nomor_pengirim String                                 // Nomor WA pengirim
  nomor_tujuan   String                                 // Nomor WA penerima
  isi_pesan      String                                 // Konten isi teks pesan WA
  tipe           String   @default("MASUK")             // Tipe pesan: MASUK / KELUAR
  sudah_diproses Boolean  @default(false)               // Status apakah pesan sudah diproses bot
  dibuatPada     DateTime @default(now())               // Waktu pesan tercatat

  @@map("log_pesan_wa")
}

// TABEL 5: Pengaturan General Toko
model Pengaturan {
  id         Int     @id @default(autoincrement()) // ID Unik Primary Key
  kunci      String  @unique                       // Kunci Pengaturan (contoh: NAMA_TOKO, REKENING_BCA)
  nilai      String                                // Nilai Konfigurasi
  keterangan String?                               // Deskripsi / Penjelasan Fungsi Pengaturan

  @@map("pengaturan")
}
